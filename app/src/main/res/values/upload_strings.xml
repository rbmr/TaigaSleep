  <string name="metric_total_sleep">Total asleep</string>
  <string name="metric_total_sleep_explanation">Time scored as sleep across REM, light and deep epochs. It excludes wake and unscored time. Source: the stage timeline.</string>
  <string name="metric_sleep_latency">Time to fall asleep</string>
  <string name="metric_sleep_latency_explanation">Time from the start of the recording to the first sleep epoch. Source: the stage timeline.</string>
  <string name="metric_sleep_efficiency">Sleep efficiency</string>
  <string name="metric_sleep_efficiency_explanation">Share of the whole recording that was scored as sleep. Total sleep divided by total duration. Source: the stage timeline.</string>
  <string name="metric_awakenings">Awakenings</string>
  <string name="metric_awakenings_explanation">Number of wake periods longer than 2 minutes between sleep onset and the final awakening. Source: the stage timeline.</string>
  <string name="metric_waso">Wake after sleep onset</string>
  <string name="metric_waso_explanation">Wake time after sleep onset and before the final awakening. Source: the stage timeline.</string>
  <string name="metric_final_awakening">Final awakening</string>
  <string name="metric_final_awakening_explanation">Wake time at the end of the recording after the last sleep epoch. Source: the stage timeline.</string>
  <string name="metric_hr_mean">Average heart rate</string>
  <string name="metric_hr_mean_explanation">Mean of all valid heart-rate samples. Source: the heart-rate stream.</string>
  <string name="metric_hr_min">Lowest heart rate</string>
  <string name="metric_hr_min_explanation">Lowest valid heart-rate sample. Source: the heart-rate stream.</string>
  <string name="metric_hr_max">Highest heart rate</string>
  <string name="metric_hr_max_explanation">Highest valid heart-rate sample. Source: the heart-rate stream.</string>
  <string name="metric_hrv_rmssd">HRV RMSSD</string>
  <string name="metric_hrv_rmssd_explanation">Beat-to-beat variation: the root mean square of successive RR-interval differences. Source: RR intervals from the sensor.</string>
  <string name="metric_hrv_sdnn">HRV SDNN</string>
  <string name="metric_hrv_sdnn_explanation">Overall heart-rate variability: the standard deviation of the RR intervals. Source: RR intervals from the sensor.</string>
  <string name="metric_hrv_count">RR intervals used</string>
  <string name="metric_hrv_count_explanation">Number of clean RR intervals used for HRV after filtering. Source: RR intervals from the sensor.</string>
  <string name="metric_movement_index">Movement index</string>
  <string name="metric_movement_index_explanation">Share of epochs with movement above 0.08 g. Source: the accelerometer stream.</string>
  <string name="metric_movement_mean">Average movement</string>
  <string name="metric_movement_mean_explanation">Average movement magnitude per epoch. Source: the accelerometer stream.</string>
  <string name="metric_movement_epochs">Epochs with movement</string>
  <string name="metric_movement_epochs_explanation">Number of epochs with movement above 0.08 g. Source: the accelerometer stream.</string>
  <string name="metric_scored_duration">Scored time</string>
  <string name="metric_scored_duration_explanation">Time covered by a scored sleep stage. Source: the stage timeline.</string>
  <string name="metric_unscored">Unscored time</string>
  <string name="metric_unscored_explanation">Time the algorithm could not score. Source: the stage timeline.</string>
  <string name="metric_total_duration">Recording length</string>
  <string name="metric_total_duration_explanation">Length of the analyzed recording. Source: recording metadata and the epoch timeline.</string>
