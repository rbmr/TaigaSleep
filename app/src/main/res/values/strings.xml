  <string name="personal_privacy_title">Privacy</string>
  <string name="personal_privacy_body">These details stay on this phone. A SleepECG analysis request sends only your age on the night of the recording, your sex and your weight; the date of birth itself is never sent or logged. They are stored with that analysis on your server. Only SleepECG uses them: wav2sleep and baseline ignore them. Leaving a field empty is fine, and SleepECG then masks the feature it cannot use and says so in the result.</string>

  <string name="about_group_project">Project</string>
  <string name="about_title">About</string>
  <string name="about_back">Back</string>
  <string name="about_version">Version %1$s</string>
  <string name="about_description">An open-source sleep tracker for Polar heart-rate sensors. Taiga records overnight data locally on your phone and can upload it to your own server for sleep staging and history.</string>
  <string name="about_source_title">Source code</string>
  <string name="about_source_subtitle">github.com/rbmr/TaigaSleep</string>
  <string name="about_license_title">License</string>
  <string name="about_license_subtitle">GPL-3.0</string>
  <string name="about_privacy_title">Privacy</string>
  <string name="about_privacy_body">Recordings stay on your phone unless you connect a server and upload them. There is no analytics or tracking in the app.</string>
  <string name="about_built_title">Built with</string>
  <string name="about_built_body">Kotlin, Jetpack Compose and the Polar BLE SDK. Sleep staging uses wav2sleep (MIT) and SleepECG (BSD-3-Clause).</string>
  <string name="about_disclaimer">Taiga Sleep is not a medical device.</string>
