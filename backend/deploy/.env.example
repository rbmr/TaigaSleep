# Copy to .env and fill in. .env is ignored by git; never commit real values.
TAIGA_BIND_ADDR=127.0.0.1
TAIGA_PORT=8090
TAIGA_APP_NAME=Taiga Sleep
TAIGA_APP_URL=https://sleep.example.com
# The header Caddy sets with the client's address. The API trusts none unless one is
# named; set it empty when the API port is exposed directly instead of through Caddy.
TAIGA_TRUSTED_PROXY_HEADERS=X-Forwarded-For

# Optional first-start admin bootstrap. Remove after the superuser exists.
TAIGA_ADMIN_EMAIL=you@example.com
TAIGA_ADMIN_PASSWORD=change-this
# Optional 32-character value for PocketBase settings encryption.
TAIGA_ENCRYPTION_KEY=

# Worker service account (create it with the commands in backend/README.md).
TAIGA_WORKER_EMAIL=worker@example.com
TAIGA_WORKER_PASSWORD=change-this
TAIGA_WORKER_ID=docker-worker

# Queue tuning.
TAIGA_JOB_LEASE_S=1800
TAIGA_JOB_MAX_ATTEMPTS=3
TAIGA_POLL_INTERVAL_S=60
# Address-space limit for one analysis subprocess. wav2sleep needs 2048.
TAIGA_JOB_MEMORY_MB=2048
TAIGA_JOB_TIMEOUT_S=3600
# Container limit for the worker supervisor.
TAIGA_WORKER_MEMORY=2g
# Build the worker image with the wav2sleep stager (default). Set false to build
# the smaller baseline-only image for a host below the requirements.
WITH_WAV2SLEEP=true
TAIGA_LOG_LEVEL=INFO
# Optional comma-separated algorithm id allowlist; empty means all installed.
TAIGA_ALGORITHMS=
