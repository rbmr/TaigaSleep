[Unit]
Description=Taiga Sleep API (Go PocketBase app)
Documentation=https://github.com/rbmr/TaigaSleep
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taiga
Group=taiga
StateDirectory=taiga-sleep
WorkingDirectory=/opt/taiga-sleep

# Defaults; override in /etc/taiga-sleep/api.env.
Environment=TAIGA_HTTP_ADDR=127.0.0.1:8090
Environment=TAIGA_DATA_DIR=/var/lib/taiga-sleep
Environment=TAIGA_JOB_MAX_ATTEMPTS=3
EnvironmentFile=-/etc/taiga-sleep/api.env

ExecStart=/opt/taiga-sleep/taiga-sleep-api serve \
    --http=${TAIGA_HTTP_ADDR} \
    --dir=${TAIGA_DATA_DIR} \
    --automigrate=false
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/taiga-sleep
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
