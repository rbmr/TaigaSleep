# Root-owned, mode 0640, group taiga. Never commit this file.
# The API binds to loopback by default; put Caddy/nginx in front for remote
# access and keep /_/ private.
TAIGA_HTTP_ADDR=127.0.0.1:8090
TAIGA_DATA_DIR=/var/lib/taiga-sleep
TAIGA_APP_URL=https://sleep.example.com
TAIGA_HOOKS_POOL=4
TAIGA_JOB_LEASE_S=1800
TAIGA_JOB_MAX_ATTEMPTS=3
# Optional, exactly 32 characters, for PocketBase settings encryption:
# TAIGA_ENCRYPTION_KEY=
